#This programs purpose is to calculate fiber optic cable installation.
#we are simulating getting input from client and figuring out the total installation cost


#print statement to print a welcome message for your user:
print("Welcome to the Fiber Optic Cable Installation Calculator!")
print()

#Retrieve the company name from the user using input().

user_company_name = ""

user_company_name = input("Enter your company name: ")

#Retrieve the number of feet of fiber optic cable to be installed from the user using input().
feet_requested = float(input("How many feet of fiber optic cable does " + user_company_name +" need installed?: "))

price_per_foot = 0.95

#Calculate the installation cost of fiber optic cable by multiplying the number of feet requested by the user by $.95 per foot.
total_cost = feet_requested * price_per_foot

#print receipt
print("-------Reciept for " + user_company_name + "-------")
print()
print("Company Name: " + user_company_name)
print("Feet Installed: " + str(feet_requested))
print("Price per Foot: $" + str(price_per_foot))
print("Total Cost: $" + str(round(total_cost, 2)))
print("-------end of reciept-------")
print()
print("Thank you for your business!")
